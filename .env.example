# Server-only. NEVER publish these values. Node 24 LTS required.
PRAXIS_HOST=127.0.0.1
PRAXIS_PORT=8787
PRAXIS_DB=./state/praxis.sqlite
PRAXIS_ADMIN_PASS=CHANGE_TO_A_LONG_RANDOM_SECRET
PRAXIS_VAULT_KEY=BASE64_OF_32_RANDOM_BYTES
# Optional read-only activation through Connections UI; no credentials shipped.
# Optional Ollama on same VM (no exposed port):
PRAXIS_OLLAMA_URL=http://127.0.0.1:11434
PRAXIS_OLLAMA_MODEL=qwen3:1.7b
# Market data ingestion is read-only and independent of the order engine.
# Uses selected broker if connected, else Trading Paper, else Broker Sandbox.
PRAXIS_MARKET_POLL_ENABLED=1
PRAXIS_MARKET_POLL_SECONDS=300
PRAXIS_MARKET_POLL_SYMBOLS=5
# Streaming free/basic subscriptions: normally <=30 symbols for US equities.
# Both Broker Basic legacy and optional OAuth client credentials are supported.
# Never put an API key in this example file.
# Background strategies are DISABLED until explicit arm and enabling in UI.
PRAXIS_STRATEGY_POLL_SECONDS=90
# Reverse proxy must terminate HTTPS and only expose dashboard through auth.

# Required with HTTPS/Netlify deployments (dashboard origin, not API origin):
PRAXIS_PUBLIC_ORIGIN=https://dashboard.example.com
PRAXIS_COOKIE_SECURE=1
# Optional disable external streams; REST remains operational:
PRAXIS_STREAMS_ENABLED=1

# Node 24 honors environment HTTP proxy/NO_PROXY when this is set:
NODE_USE_ENV_PROXY=1

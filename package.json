  "dependencies": {
    "https-proxy-agent": "^9.1.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/forms": "^0.5.11",
    "tailwindcss": "^4.3.3"
  }
}

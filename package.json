{
  "name": "praxis-os",
  "version": "0.4.2-phase-a",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node --test tests/*.test.mjs",
